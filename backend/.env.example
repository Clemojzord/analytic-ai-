# ── Analytic AI — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values

# App
APP_NAME="Analytic AI"
APP_VERSION="1.0.0"
DEBUG=true

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./analytic_ai.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/analytic_ai

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=50

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://analytic-ai-icg.web.app

# Currency
DEFAULT_CURRENCY=KES
DECIMAL_PLACES=2

# Report branding
COMPANY_NAME="Analytic AI"
REPORT_LOGO_URL=

# Optional: OpenAI for AI-powered insights
# OPENAI_API_KEY=sk-...
